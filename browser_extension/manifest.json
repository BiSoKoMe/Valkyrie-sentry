{
  "manifest_version": 3,
  "name": "Valkyrie Local Context",
  "version": "0.1.0",
  "description": "Sends privacy-minimized browser interaction context to the local Valkyrie engine.",
  "permissions": ["nativeMessaging", "tabs", "webNavigation"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {"default_title": "Valkyrie Local Context"}
}
