# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
/build/
venv/
.venv/

# Runtime data (auto-created; never commit)
data/*
!data/.gitkeep

# Databases & logs
*.db
*.log
logs/
service_stdout.log
service_stderr.log

# Tools (downloaded binaries, e.g. nssm.exe)
tools/

# Rust accelerator build artifacts (the crate's Cargo.lock IS tracked)
rust/**/target/
*.whl

# WireGuard / resolver configs (may contain keys)
*.conf
wg*.conf
*.key
*.pem

# Environment
.env
.env.*

# Large downloaded blocklists
blocklists/steven_black_hosts.txt
blocklists/oisd_full.txt

# IDE / local settings
.vscode/
.idea/
*.suo
*.user
.claude/settings.local.json

# Local agent, editor, and connector state. These files may contain host paths,
# access configuration, or user-specific instructions and are never release
# artifacts.
.agents/
.codex/
.mcp.json
AGENTS.md
skills-lock.json

# OS
.DS_Store
Thumbs.db
Windows.lnk

# One-off local verification output and backups.
ci_*/
*.bak

# Electron desktop app — dependencies & build outputs (never commit)
node_modules/
electron/engine_payload/
electron/dist/
dist_installer/
ValkyrieSetup.exe
ValkyriePortable.exe
# ...but electron/build/ holds SOURCE (icon.ico, installer.nsh) — keep it tracked
!electron/build/
!electron/build/**
electron/build/*.bak

# Next.js build output (desktop/ dashboard prototype)
desktop/.next/

# Runtime state (portable/dev data dir) — never commit
ValkyrieData/

# Coverage artifacts (regenerated by the coverage CI job; never commit)
.coverage
.coverage.*
htmlcov/

# Red-team evaluation run outputs (generated; scores should not live in the repo)
redteam/evaluation/results/*.json
valkyrie/_build.py

# Kernel driver build output (driver/build_km.bat). Never commit a .sys — an
# unsigned binary in a repo invites someone to load it.
driver/valkyrie_km/objs/
driver/valkyrie_km/x64/
*.sys
*.obj

# graphify knowledge graph (generated). ~16MB of graph.json/graph.html plus a
# machine-local cache/ and absolute host paths in .graphify_root. Rebuild with
# `graphify . --code-only && graphify cluster-only . --no-label` — AST-only,
# fully local, no API cost.
graphify-out/

# Scratch driver for one-shot Electron verification; hardcodes a per-session
# temp path, so it is never valid on a second run.
electron/_verify_driver_TEMP.js
