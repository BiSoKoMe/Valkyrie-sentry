# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
/build/
venv/
.venv/

# Runtime data (auto-created; never commit)
data/*
!data/.gitkeep

# Databases & logs
*.db
*.log
logs/
service_stdout.log
service_stderr.log

# Tools (downloaded binaries, e.g. nssm.exe)
tools/

# Rust accelerator build artifacts (the crate's Cargo.lock IS tracked)
rust/**/target/
*.whl

# WireGuard / resolver configs (may contain keys)
*.conf
wg*.conf
*.key
*.pem

# Environment
.env
.env.*

# Large downloaded blocklists
blocklists/steven_black_hosts.txt
blocklists/oisd_full.txt

# IDE / local settings
.vscode/
.idea/
*.suo
*.user
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Electron desktop app — dependencies & build outputs (never commit)
node_modules/
electron/engine_payload/
electron/dist/
dist_installer/
ValkyrieSetup.exe
ValkyriePortable.exe
# ...but electron/build/ holds SOURCE (icon.ico, installer.nsh) — keep it tracked
!electron/build/
!electron/build/**

# Next.js build output (desktop/ dashboard prototype)
desktop/.next/
